# ═══════════════════════════════════════════════════════════════
# CampusOS Environment Variables
# Copy to .env.local: cp .env.example .env.local
# ═══════════════════════════════════════════════════════════════

# ── Database (PostgreSQL 16) ──────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusos?schema=platform"

# ── Mocking (Bypass Redis/Kafka) ─────────────────────────────
# Set to 'true' to use in-memory mocks instead of Redis and Kafka.
# This allows the project to run without Docker for everything except the DB.
USE_MOCK_SERVICES="false"

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS="localhost:9092"

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET="change-me-in-local-min-32-chars-long"

# ── API ───────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
